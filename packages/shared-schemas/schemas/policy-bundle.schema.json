{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logclean.local/schemas/policy-bundle.schema.json",
  "title": "PolicyBundle",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "org_id",
    "org_name",
    "rules",
    "intent_rules",
    "actions",
    "justification_required",
    "strict_mode"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "org_id": { "type": "string" },
    "org_name": { "type": "string" },
    "team_id": { "type": "string" },
    "team_name": { "type": "string" },
    "rules": { "type": "object" },
    "intent_rules": { "type": "object" },
    "actions": { "type": "object" },
    "justification_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "strict_mode": { "type": "boolean" }
  },
  "additionalProperties": false
}
