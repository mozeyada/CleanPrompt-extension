{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanprompt.local/schemas/policy-bundle.schema.json",
  "title": "PolicyBundle",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "org_id",
    "org_name",
    "rules",
    "intent_rules",
    "actions",
    "justification_required",
    "strict_mode"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "org_id": { "type": "string" },
    "org_name": { "type": "string" },
    "team_id": { "type": "string" },
    "team_name": { "type": "string" },
    "app_scopes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rules": {
      "type": "object",
      "required": ["active_rule_ids", "bundle_version"],
      "properties": {
        "active_rule_ids": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "bundle_version": { "type": "string" },
        "local_bundle_version": { "type": "string" },
        "total_rules": { "type": "number" },
        "remote_updates_enabled": { "type": "boolean" },
        "stage2_ner_enabled": { "type": "boolean" },
        "fallback_mode": { "type": "string" }
      },
      "additionalProperties": false
    },
    "intent_rules": { "type": "object" },
    "actions": { "type": "object" },
    "justification_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ui_copy_version": { "type": "string" },
    "metadata_analytics": {
      "type": "object",
      "required": ["enabled", "raw_prompt_retention", "user_level_drilldown"],
      "properties": {
        "enabled": { "type": "boolean" },
        "raw_prompt_retention": { "type": "boolean" },
        "user_level_drilldown": { "type": "boolean" },
        "aggregation_thresholds": {
          "type": "object",
          "properties": {
            "min_events": { "type": "number" },
            "min_distinct_actors": { "type": "number" }
          },
          "required": ["min_events", "min_distinct_actors"],
          "additionalProperties": false
        },
        "rotating_actor_window_days": { "type": "number" }
      },
      "additionalProperties": false
    },
    "strict_mode": { "type": "boolean" }
  },
  "additionalProperties": false
}
