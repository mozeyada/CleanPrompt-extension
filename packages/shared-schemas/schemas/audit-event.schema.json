{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanprompt.local/schemas/audit-event.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "required": [
    "schema_version",
    "org_id",
    "device_id",
    "extension_version",
    "site",
    "action",
    "intent_label",
    "intent_confidence_bucket",
    "sensitivity_categories",
    "rule_ids",
    "count_summary",
    "prompt_size_bucket",
    "timestamp_bucket",
    "raw_text_absent"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "org_id": { "type": "string" },
    "org_name": { "type": "string" },
    "team_id": { "type": "string" },
    "team_name": { "type": "string" },
    "user_id": { "type": "string" },
    "device_id": { "type": "string" },
    "extension_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "rules_version": { "type": "string" },
    "site": { "type": "string" },
    "action": { "type": "string" },
    "intent_label": { "type": "string" },
    "intent_confidence_bucket": { "type": "string" },
    "sensitivity_categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rule_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "count_summary": { "type": "object" },
    "prompt_size_bucket": { "type": "string" },
    "timestamp_bucket": { "type": "string" },
    "raw_text_absent": { "const": true },
    "rotating_actor_id": { "type": "string" },
    "strict_mode": { "type": "boolean" },
    "justification_required": { "type": "boolean" },
    "justification_provided": { "type": "boolean" }
  },
  "additionalProperties": false
}
