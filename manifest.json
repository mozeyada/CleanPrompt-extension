{
  "manifest_version": 3,
  "name": "CleanPrompt - Privacy-First AI Prompt Protection",
  "version": "1.2.0",
  "description": "Redact sensitive data locally before it reaches AI tools, then keep only metadata-safe workflow insight for admins.",
  "author": "CleanPrompt",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "clipboardWrite",
    "clipboardRead"
  ],

  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://copilot.microsoft.com/*",
    "https://www.bing.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["engine/redactor.js", "content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "CleanPrompt - Clean prompts before AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "engine/ner-worker.js",
        "engine/transformers.min.js",
        "engine/rules.json"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
